# Copy to .env and edit. Everything is optional: the app works fully offline without any of these.
# Enables LLM-powered categorisation, coach summary and "Ask your money".
OPENAI_API_KEY=
# Model used for the optional LLM features (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# SQLite file location (default: rupee_ledger.db next to app.py)
RUPEE_LEDGER_DB=rupee_ledger.db
# Set to 1 only for local development
FLASK_DEBUG=0
# Set to 1 to seed sample data at startup (useful for public demos on hosts with temporary disks)
RUPEE_LEDGER_DEMO=0
